# Copy these names into GitHub Actions secrets/variables. Never commit real credentials.

# Repository variables
GEMINI_MODEL=gemini-2.5-pro
ADOBE_SCOPE=<copy-the-exact-scopes-from-your-adobe-credential>

# GitHub Actions secrets
GEMINI_API_KEY=

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_TEMPLATE_ID=

INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Do NOT store ADOBE_ACCESS_TOKEN.
# The workflow generates a fresh Adobe access token from the client credentials.
