# Copy these names into GitHub Actions secrets/variables. Never commit real credentials.

# Repository variables
GEMINI_MODEL=gemini-2.5-pro
PUBLIC_ASSET_BASE_URL=<public-https-base-url-for-hosted-carousel-images>

# GitHub Actions secrets
GEMINI_API_KEY=

INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
